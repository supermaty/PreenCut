        "text": "核生员派星的一个"
    },
    {
        "start": 1039.27,
        "end": 1040.01,
        "text": "什么"
    },
    {
        "start": 1040.01,
        "end": 1042.93,
        "text": "这一直以来就是核生员派星的"
    },
    {
        "start": 1042.93,
        "end": 1044.31,
        "text": "缺点"
    },
    {
        "start": 1044.31,
        "end": 1045.81,
        "text": "可以说是缺点"
    },
    {
        "start": 1045.81,
        "end": 1047.53,
        "text": "他们没啥能说的了"
    },
    {
        "start": 1047.53,
        "end": 1049.35,
        "text": "能说的就是绿了"
    },
    {
        "start": 1049.35,
        "end": 1051.59,
        "text": "因为他是三架铁"
    },
    {
        "start": 1051.59,
        "end": 1055.27,
        "text": "和和飞鹤家是一模一样的"
    },
    {
        "start": 1055.27,
        "end": 1055.79,
        "text": "三架铁"
    },
    {
        "start": 1055.79,
        "end": 1058.17,
        "text": "但是他家的铁的含量没有那么高"
    },
    {
        "start": 1058.17,
        "end": 1060.87,
        "text": "再加上人家的膳食纤维"
    },
    {
        "start": 1060.87,
        "end": 1061.99,
        "text": "优化的"
    },
    {
        "start": 1061.99,
        "end": 1063.43,
        "text": "比兴肥烦家的好"
    },
    {
        "start": 1063.43,
        "end": 1065.33,
        "text": "所以他只是绿"
    },
    {
        "start": 1065.33,
        "end": 1066.87,
        "text": "人家不干"
    },
    {
        "start": 1066.87,
        "end": 1068.29,
        "text": "好吧"
    },
    {
        "start": 1068.29,
        "end": 1070.11,
        "text": "可以可以喝二三段"
    },
    {
        "start": 1070.11,
        "end": 1070.35,
        "text": "啊"
    },
    {
        "start": 1070.35,
        "end": 1071.03,
        "text": "二三段"
    },
    {
        "start": 1071.03,
        "end": 1071.47,
        "text": "好吧"
    },
    {
        "start": 1071.47,
        "end": 1072.67,
        "text": "其实和尘原家"
    },
    {
        "start": 1072.67,
        "end": 1075.05,
        "text": "我更给你推荐的是"
    },
    {
        "start": 1075.05,
        "end": 1076.63,
        "text": "他的本尊"
    },
    {
        "start": 1076.63,
        "end": 1078.29,
        "text": "谁呢"
    },
    {
        "start": 1078.29,
        "end": 1078.91,
        "text": "派星"
    },
    {
        "start": 1078.91,
        "end": 1079.95,
        "text": "好吧"
    },
    {
        "start": 1079.95,
        "end": 1082.05,
        "text": "其实你在和尘原家"
    },
    {
        "start": 1082.05,
        "end": 1082.81,
        "text": "你喝他"
    },
    {
        "start": 1082.81,
        "end": 1083.81,
        "text": "喝他"
    }
]